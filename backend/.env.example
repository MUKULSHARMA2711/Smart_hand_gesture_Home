# Copy to .env and adjust. All variables are optional.
SMARTHOME_LOG_LEVEL=INFO
SMARTHOME_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SMARTHOME_EVENT_LOG_MAX_SIZE=1000
# Simulated network/firmware delay for virtual devices.
SMARTHOME_VIRTUAL_DEVICE_LATENCY_MS=0
# Fix the sensor simulation's random seed for reproducible readings.
# SMARTHOME_SENSOR_SEED=42

# Gesture control
SMARTHOME_GESTURE_CONFIDENCE_THRESHOLD=0.75
# Device actions gestures may not trigger (JSON list). Use [] to allow everything.
SMARTHOME_GESTURE_BLOCKED_ACTIONS=["unlock"]
SMARTHOME_GESTURE_HISTORY_MAX_SIZE=500

# AI agent. "mock" (default) needs no API key and is deterministic.
# AI_PROVIDER / AI_MODEL / AI_API_KEY (without the prefix) are accepted too.
SMARTHOME_AI_PROVIDER=mock
SMARTHOME_AI_MODEL=claude-opus-5-5
# Optional: if unset, the Anthropic SDK uses ANTHROPIC_API_KEY or an `ant auth login` profile.
# Never commit a real key. Put it in backend/.env (git-ignored) or your shell environment.
# SMARTHOME_AI_API_KEY=
SMARTHOME_AI_EFFORT=medium
SMARTHOME_AI_ALLOW_UNLOCK=true

# Machine learning (trained at startup on deterministic *simulated* data)
SMARTHOME_ML_ENABLED=true
SMARTHOME_ML_SEED=7
SMARTHOME_ML_DATASET_DAYS=60
SMARTHOME_ML_PREDICTION_THRESHOLD=0.5
SMARTHOME_ML_ANOMALY_ACTIVE_MINUTES=15
