# Copy to .env and adjust. All variables are optional.
SMARTHOME_LOG_LEVEL=INFO
SMARTHOME_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SMARTHOME_EVENT_LOG_MAX_SIZE=1000
# Simulated network/firmware delay for virtual devices.
SMARTHOME_VIRTUAL_DEVICE_LATENCY_MS=0
# Fix the sensor simulation's random seed for reproducible readings.
# SMARTHOME_SENSOR_SEED=42

# Gesture control
SMARTHOME_GESTURE_CONFIDENCE_THRESHOLD=0.75
# Device actions gestures may not trigger (JSON list). Use [] to allow everything.
SMARTHOME_GESTURE_BLOCKED_ACTIONS=["unlock"]
SMARTHOME_GESTURE_HISTORY_MAX_SIZE=500
